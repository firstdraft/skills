{
  "format": "firstdraft.foundation-plan.sketch/0.23",
  "target": {
    "id": "rails",
    "profile": "rails-sketch/2026-11"
  },
  "application": {
    "key": "recipes",
    "name": "Recipes",
    "home_index": "recipe",
    "native": {},
    "delivery": {},
    "entities": [
      {
        "subject_uuid": "01a0caf3-0904-7000-8000-000000000001",
        "key": "user",
        "name": "User",
        "primary_descriptor": {
          "field": "user.name"
        },
        "account": {
          "identifiers": [
            {
              "kind": "email",
              "name": "Email"
            }
          ],
          "sign_in_methods": [
            {
              "kind": "password"
            }
          ],
          "registration": {
            "mode": "self_service",
            "inputs": [
              {
                "field": "user.name",
                "required": true
              }
            ]
          },
          "recovery": {
            "kind": "password_reset"
          },
          "lockout": {}
        },
        "fields": [
          {
            "subject_uuid": "01a0caf3-0904-7000-8000-000000000002",
            "key": "name",
            "name": "Name",
            "type": "short_text",
            "required": true
          }
        ],
        "associations": [
          {
            "subject_uuid": "01a0caf3-0904-7000-8000-000000000003",
            "key": "recipes",
            "kind": "direct",
            "name": "Recipes",
            "reference": "recipe.author",
            "side": "referenced"
          }
        ],
        "policies": [
          {
            "subject_uuid": "01a0caf3-0904-7000-8000-000000000004",
            "key": "signed_in",
            "operation": "use_app",
            "allow_when": {
              "kind": "comparison",
              "left": {
                "target": {
                  "record": "current"
                }
              },
              "operator": "equals",
              "right": {
                "kind": "environment",
                "name": "current_account"
              }
            }
          }
        ]
      },
      {
        "subject_uuid": "01a0caf3-0904-7000-8000-000000000005",
        "key": "recipe",
        "name": "Recipe",
        "primary_descriptor": {
          "field": "recipe.title"
        },
        "fields": [
          {
            "subject_uuid": "01a0caf3-0904-7000-8000-000000000006",
            "key": "title",
            "name": "Title",
            "type": "short_text",
            "required": true
          },
          {
            "subject_uuid": "01a0caf3-0904-7000-8000-000000000007",
            "key": "published",
            "name": "Published",
            "type": "boolean",
            "required": true,
            "default": {
              "kind": "literal",
              "value": false
            }
          }
        ],
        "references": [
          {
            "subject_uuid": "01a0caf3-0904-7000-8000-000000000008",
            "key": "author",
            "name": "Author",
            "targets": [
              "user"
            ],
            "required": true,
            "one_to_one": false,
            "on_referenced_deleted": "delete_referencing_record",
            "immutable": true
          }
        ],
        "policies": [
          {
            "subject_uuid": "01a0caf3-0904-7000-8000-000000000009",
            "key": "read_published_or_own",
            "operation": "read",
            "allow_when": {
              "kind": "or",
              "expressions": [
                {
                  "kind": "and",
                  "expressions": [
                    {
                      "kind": "matches_policy",
                      "record": {
                        "kind": "environment",
                        "name": "current_account"
                      },
                      "policy": "user.signed_in"
                    },
                    {
                      "kind": "comparison",
                      "left": {
                        "target": {
                          "field": "recipe.published"
                        }
                      },
                      "operator": "equals",
                      "right": {
                        "kind": "literal",
                        "value": true
                      }
                    }
                  ]
                },
                {
                  "kind": "comparison",
                  "left": {
                    "target": {
                      "association": "recipe.author"
                    }
                  },
                  "operator": "equals",
                  "right": {
                    "kind": "environment",
                    "name": "current_account"
                  }
                }
              ]
            }
          },
          {
            "subject_uuid": "01a0caf3-0904-7000-8000-00000000000a",
            "key": "manage_own",
            "operation": "manage",
            "allow_when": {
              "kind": "comparison",
              "left": {
                "target": {
                  "association": "recipe.author"
                }
              },
              "operator": "equals",
              "right": {
                "kind": "environment",
                "name": "current_account"
              }
            }
          }
        ],
        "scaffold": {
          "resource_routes": [
            "index",
            "show",
            "new",
            "create",
            "edit",
            "update"
          ],
          "index": {
            "authorization": {
              "policy": "recipe.read_published_or_own"
            },
            "projection": [
              {
                "field": "recipe.title"
              }
            ]
          },
          "show": {
            "authorization": {
              "policy": "recipe.read_published_or_own"
            },
            "projection": [
              {
                "field": "recipe.title"
              },
              {
                "field": "recipe.published"
              }
            ]
          },
          "create": {
            "authorization": {
              "policy": "recipe.manage_own"
            },
            "inputs": [
              {
                "field": "recipe.title"
              },
              {
                "field": "recipe.published"
              }
            ],
            "bindings": [
              {
                "reference": "recipe.author",
                "value": {
                  "kind": "environment",
                  "name": "current_account"
                }
              }
            ]
          },
          "update": {
            "authorization": {
              "policy": "recipe.manage_own"
            },
            "inputs": [
              {
                "field": "recipe.title"
              },
              {
                "field": "recipe.published"
              }
            ]
          }
        }
      }
    ],
    "development_data": [
      {
        "subject_uuid": "01a0caf3-0904-7000-8000-00000000000b",
        "key": "ana",
        "entity": "user",
        "fields": [
          {
            "field": "user.name",
            "value": {
              "kind": "literal",
              "value": "Ana"
            }
          }
        ],
        "account": {
          "identifiers": [
            {
              "kind": "email",
              "value": "ana@example.com"
            }
          ],
          "credentials": [
            {
              "kind": "password",
              "value": "password123"
            }
          ]
        }
      },
      {
        "subject_uuid": "01a0caf3-0904-7000-8000-00000000000c",
        "key": "pancakes",
        "entity": "recipe",
        "fields": [
          {
            "field": "recipe.title",
            "value": {
              "kind": "literal",
              "value": "Pancakes"
            }
          },
          {
            "field": "recipe.published",
            "value": {
              "kind": "literal",
              "value": true
            }
          }
        ],
        "references": [
          {
            "reference": "recipe.author",
            "value": {
              "kind": "reference_record",
              "record": "user.ana"
            }
          }
        ]
      }
    ]
  }
}
