      "required": true
     }
    ],
    "references": [
     {
      "subject_uuid": "01a0caf3-0761-7000-8000-000000000206",
      "key": "recipe",
      "name": "Recipe",
      "targets": [
       "recipe"
      ],
      "required": true,
      "one_to_one": false,
      "on_referenced_deleted": "delete_referencing_record",
      "immutable": true
     },
     {
      "subject_uuid": "01a0caf3-0761-7000-8000-000000000207",
      "key": "author",
      "name": "Author",
      "targets": [
       "user"
      ],
      "required": true,
      "one_to_one": false,
      "on_referenced_deleted": "delete_referencing_record",
      "immutable": true
     }
    ],
    "policies": [
     {
      "subject_uuid": "01a0caf3-0761-7000-8000-000000000208",
      "key": "read_with_recipe",
      "operation": "read",
      "allow_when": {
       "kind": "matches_policy",
       "association": "comment.recipe",
       "policy": "recipe.read_published_or_own"
      }
     }
    ],
    "scaffold": {
     "create": {
      "authorization": {
       "policy": "user.signed_in",
       "record": {
        "kind": "environment",
        "name": "current_account"
       }
      },
      "inputs": [
       {
        "field": "comment.body"
       }
      ],
      "bindings": [
       {
        "reference": "comment.author",
        "value": {
         "kind": "environment",
         "name": "current_account"
        }
       }
      ]
     }
    }
   }
