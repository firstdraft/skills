            }
          },
          {
            "field": "user.approved",
            "value": {
              "kind": "literal",
              "value": true
            }
          }
        ],
        "account": {
          "identifiers": [
            {
              "kind": "email",
              "value": "ana@example.com"
            }
          ],
          "credentials": [
            {
              "kind": "password",
              "value": "password123"
            }
          ]
        }
      }
    ]
  }
}
