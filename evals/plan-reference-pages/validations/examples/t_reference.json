        "subject_uuid": "01a1cbcc-7619-7eb5-9c4b-f12d40e3ca96",
        "key": "not_in_past",
        "kind": "comparison",
        "comparisons": [
         {
          "operator": "greater_than_or_equal_to",
          "right": {
           "kind": "environment",
           "name": "current_date"
          }
         }
        ]
       }
      ]
     },
     {
      "subject_uuid": "01a1cba7-b691-768c-b692-4d0c3885e223",
