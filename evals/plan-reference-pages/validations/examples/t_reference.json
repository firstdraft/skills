       },
       {
        "subject_uuid": "01a1cba7-b691-7fa2-b80c-25ecad0f5cce",
        "key": "code_not_reserved",
        "kind": "exclusion",
        "forbidden_values": [
         {
          "kind": "literal",
          "value": "TEST"
         },
         {
          "kind": "literal",
          "value": "DEMO"
         }
        ]
       }
      ]
     },
     {
      "subject_uuid": "01a1cba7-b691-7ae9-bf36-35e9853b8a3e",
      "key": "kind",
      "name": "Kind",
      "type": "enum",
      "required": true,
      "settings": {
       "values": [
        {
         "subject_uuid": "01a1cba7-b691-7c85-9966-78ebde85c479",
         "key": "online",
         "name": "Online"
        },
        {
         "subject_uuid": "01a1cba7-b691-72db-b65d-275f4d63dd0d",
         "key": "in_person",
         "name": "In person"
        }
       ]
      }
     },
