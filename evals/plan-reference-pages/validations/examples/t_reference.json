        "subject_uuid": "01a1cba7-b691-749b-87e0-224d7aaef373",
        "key": "room_for_in_person",
        "kind": "presence",
        "when": {
         "kind": "comparison",
         "left": {
          "target": {
           "field": "workshop.kind"
          }
         },
         "operator": "equals",
         "right": {
          "kind": "literal",
          "value": "in_person"
         }
        }
       },
       {
        "subject_uuid": "01a1cba7-b691-7980-8088-4c01548e299b",
        "key": "no_room_online",
        "kind": "absence",
        "when": {
         "kind": "comparison",
         "left": {
          "target": {
           "field": "workshop.kind"
          }
         },
         "operator": "equals",
         "right": {
          "kind": "literal",
          "value": "online"
         }
        }
       }
      ]
     },
     {
      "subject_uuid": "01a1cba7-b691-78a1-8075-ade798c97147",
      "key": "capacity",
      "name": "Capacity",
      "type": "integer",
      "required": false,
      "validations": [
       {
        "subject_uuid": "01a1cba7-b691-73db-b78b-c609be5b29bc",
        "key": "capacity_range",
        "kind": "comparison",
        "comparisons": [
         {
          "operator": "greater_than_or_equal_to",
          "right": {
           "kind": "literal",
           "value": 1
          }
         },
         {
          "operator": "less_than_or_equal_to",
          "right": {
           "kind": "literal",
           "value": 200
          }
         }
        ]
       }
      ]
     },
