      "subject_uuid": "01a0caf3-0770-7000-8000-00000000009c",
      "key": "title",
      "name": "Title",
      "type": "short_text",
      "required": true
     },
     {
      "subject_uuid": "01a0caf3-0770-7000-8000-00000000009a",
      "key": "status",
      "name": "Status",
      "type": "state_machine",
      "required": false,
      "settings": {
       "initial_state": "open",
       "states": [
        {
         "subject_uuid": "01a0caf3-0770-7000-8000-000000000096",
         "key": "open",
         "name": "Open"
        },
        {
         "subject_uuid": "01a0caf3-0770-7000-8000-000000000097",
         "key": "done",
         "name": "Done"
        }
       ],
       "transitions": [
        {
         "subject_uuid": "01a0caf3-0770-7000-8000-000000000098",
         "key": "complete",
         "from": [
          "open"
         ],
         "to": "done",
         "effects": [
          {
           "kind": "set_field",
           "field": "task.completed_at",
           "value": {
            "kind": "environment",
            "name": "current_time"
           }
          }
         ]
        },
        {
         "subject_uuid": "01a0caf3-0770-7000-8000-000000000099",
         "key": "reopen",
         "from": [
          "done"
         ],
         "to": "open",
         "effects": [
          {
           "kind": "set_field",
           "field": "task.completed_at",
           "value": {
            "kind": "literal",
            "value": null
           }
          }
         ]
        }
       ],
       "when": {
        "kind": "comparison",
        "left": {
         "target": {
          "field": "task.tracked"
         }
        },
        "operator": "equals",
        "right": {
         "kind": "literal",
         "value": true
        }
       }
      }
     },
     {
      "subject_uuid": "01a0caf3-0770-7000-8000-00000000009d",
      "key": "completed_at",
      "name": "Completed at",
      "type": "datetime",
      "required": false
     },
     {
