{
 "format": "firstdraft.foundation-plan.sketch/0.23",
 "target": {
  "id": "rails",
  "profile": "rails-sketch/2026-10"
 },
 "application": {
  "key": "tasks",
  "name": "Tasks",
  "native": {},
  "delivery": {},
  "entities": [
   {
    "subject_uuid": "01a0caf3-0770-7000-8000-00000000017d",
    "key": "task",
    "name": "Task",
    "primary_descriptor": {
     "field": "task.title"
    },
    "fields": [
     {
      "subject_uuid": "01a0caf3-0770-7000-8000-00000000017e",
      "key": "title",
      "name": "Title",
      "type": "short_text",
      "required": true
     },
     {
      "subject_uuid": "01a0caf3-0770-7000-8000-00000000017c",
      "key": "status",
      "name": "Status",
      "type": "state_machine",
      "required": true,
      "settings": {
       "initial_state": "open",
       "states": [
        {
         "subject_uuid": "01a0caf3-0770-7000-8000-000000000178",
         "key": "open",
         "name": "Open"
        },
        {
         "subject_uuid": "01a0caf3-0770-7000-8000-000000000179",
         "key": "done",
         "name": "Done"
        }
       ],
       "transitions": [
        {
         "subject_uuid": "01a0caf3-0770-7000-8000-00000000017a",
         "key": "complete",
         "from": [
          "open"
         ],
         "to": "done",
         "effects": [
          {
           "kind": "set_field",
           "field": "task.completed_at",
           "value": {
            "kind": "environment",
            "name": "current_time"
           }
          }
         ]
        },
        {
         "subject_uuid": "01a0caf3-0770-7000-8000-00000000017b",
         "key": "reopen",
         "from": [
          "done"
         ],
         "to": "open",
         "effects": [
          {
           "kind": "set_field",
           "field": "task.completed_at",
           "value": {
            "kind": "literal",
            "value": null
           }
          }
         ]
        }
       ]
      }
     },
     {
      "subject_uuid": "01a0caf3-0770-7000-8000-00000000017f",
      "key": "completed_at",
      "name": "Completed at",
      "type": "datetime",
      "required": false
     }
    ],
    "scaffold": {
     "resource_routes": [
      "index",
      "show",
      "new",
      "create",
      "edit",
      "update"
     ],
     "index": {
      "authorization": "public",
      "projection": [
       {
        "field": "task.title"
       },
       {
        "field": "task.status"
       },
       {
        "field": "task.completed_at"
       }
      ],
      "ordering": "task.by_status"
     },
     "show": {
      "authorization": "public",
      "projection": [
       {
        "field": "task.title"
       },
       {
        "field": "task.status"
       },
       {
        "field": "task.completed_at"
       }
      ]
     },
     "create": {
      "authorization": "public",
      "inputs": [
       {
        "field": "task.title"
       }
      ]
     },
     "update": {
      "authorization": "public",
      "inputs": [
       {
        "field": "task.title"
       }
      ]
     }
    },
    "orderings": [
     {
      "subject_uuid": "01a0caf3-0770-7000-8000-000000000180",
      "key": "by_status",
      "terms": [
       {
        "field": "task.status",
        "direction": "ascending"
       },
       {
        "system_field": "id",
        "direction": "ascending"
       }
      ]
     }
    ]
   }
  ]
 }
}