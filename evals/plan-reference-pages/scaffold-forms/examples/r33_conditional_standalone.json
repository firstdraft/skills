          },
          {
            "subject_uuid": "01a0caf3-07f0-7000-8000-000000000003",
            "key": "body",
            "name": "Body",
            "type": "long_text",
            "required": false
          },
          {
            "subject_uuid": "01a0caf3-07f0-7000-8000-000000000006",
            "key": "kind",
            "name": "Kind",
            "type": "enum",
            "required": true,
            "settings": {
              "values": [
                {
                  "subject_uuid": "01a0caf3-07f0-7000-8000-000000000004",
                  "key": "memo",
                  "name": "Memo"
                },
                {
                  "subject_uuid": "01a0caf3-07f0-7000-8000-000000000005",
                  "key": "reminder",
                  "name": "Reminder"
                }
              ]
            },
            "default": {
              "kind": "literal",
              "value": "memo"
            }
          },
          {
            "subject_uuid": "01a0caf3-07f0-7000-8000-000000000008",
            "key": "remind_on",
            "name": "Remind on",
            "type": "date",
            "required": false,
            "validations": [
