{
  "format": "firstdraft.foundation-plan.sketch/0.23",
  "target": {
    "id": "rails",
    "profile": "rails-sketch/2026-10"
  },
  "application": {
    "key": "notebook",
    "name": "Notebook",
    "native": {},
    "delivery": {},
    "entities": [
      {
        "subject_uuid": "01a1cb99-ff9b-7436-b32f-bc05a98d708e",
        "key": "user",
        "name": "User",
        "primary_descriptor": {
          "field": "user.name"
        },
        "fields": [
          {
            "subject_uuid": "01a1cb99-ff9b-7436-b32f-bc06e08be9f0",
            "key": "name",
            "name": "Name",
            "type": "short_text",
            "required": true
          }
        ],
        "associations": [
          {
            "subject_uuid": "01a1cb99-ff9b-7436-b32f-bc0729227f98",
            "key": "notes",
            "kind": "direct",
            "name": "Notes",
            "reference": "note.author",
            "side": "referenced"
          }
        ],
        "account": {
          "identifiers": [
            {
              "kind": "email",
              "name": "Email"
            }
          ],
          "sign_in_methods": [
            {
              "kind": "password"
            }
          ],
          "registration": {
            "mode": "self_service",
            "inputs": [
              {
                "field": "user.name",
                "required": true
              }
            ]
          },
          "recovery": {
            "kind": "password_reset"
          },
          "lockout": {}
        },
        "policies": [
          {
            "subject_uuid": "01a1cb99-ff9b-7436-b32f-bc0878d86d79",
            "key": "manage_self",
            "operation": "manage",
            "allow_when": {
              "kind": "comparison",
              "left": {
                "target": {
                  "record": "current"
                }
              },
              "operator": "equals",
              "right": {
                "kind": "environment",
                "name": "current_account"
              }
            }
          }
        ],
        "scaffold": {
          "resource_routes": [
            "destroy"
          ],
          "destroy": {
            "authorization": {
              "policy": "user.manage_self"
            }
          }
        }
      },
      {
        "subject_uuid": "01a1cb99-ff9b-7436-b32f-bc093e6e66d5",
        "key": "note",
        "name": "Note",
        "primary_descriptor": {
          "field": "note.title"
        },
        "fields": [
          {
            "subject_uuid": "01a1cb99-ff9b-7436-b32f-bc0a1e10ea53",
            "key": "title",
            "name": "Title",
            "type": "short_text",
            "required": true
          }
        ],
        "references": [
          {
            "subject_uuid": "01a1cb99-ff9b-7436-b32f-bc0b29c37a14",
            "key": "author",
            "name": "Author",
            "required": true,
            "immutable": true,
            "on_referenced_deleted": "delete_referencing_record",
            "targets": [
              "user"
            ]
          }
        ],
        "policies": [
          {
            "subject_uuid": "01a1cb99-ff9b-7436-b32f-bc0ccaa866cc",
            "key": "manage_own",
            "operation": "manage",
            "allow_when": {
              "kind": "comparison",
              "left": {
                "target": {
                  "association": "note.author"
                }
              },
              "operator": "equals",
              "right": {
                "kind": "environment",
                "name": "current_account"
              }
            }
          }
        ],
        "scaffold": {
          "resource_routes": [
            "index",
            "show",
            "new",
            "create",
            "edit",
            "update",
            "destroy"
          ],
          "index": {
            "authorization": {
              "policy": "note.manage_own"
            },
            "projection": [
              {
                "field": "note.title"
              }
            ]
          },
          "show": {
            "authorization": {
              "policy": "note.manage_own"
            },
            "projection": [
              {
                "field": "note.title"
              }
            ]
          },
          "create": {
            "authorization": {
              "policy": "note.manage_own"
            },
            "inputs": [
              {
                "field": "note.title"
              }
            ],
            "bindings": [
              {
                "reference": "note.author",
                "value": {
                  "kind": "environment",
                  "name": "current_account"
                }
              }
            ]
          },
          "update": {
            "authorization": {
              "policy": "note.manage_own"
            },
            "inputs": [
              {
                "field": "note.title"
              }
            ]
          },
          "destroy": {
            "authorization": {
              "policy": "note.manage_own"
            }
          }
        }
      }
    ],
    "home_index": "note"
  }
}
