            "subject_uuid": "01a1cb98-7455-7381-875e-1862a20cb389",
            "key": "manage_own",
            "operation": "manage",
            "allow_when": {
              "kind": "comparison",
              "left": {
                "target": {
                  "association": "note.author"
                }
              },
              "operator": "equals",
              "right": {
                "kind": "environment",
                "name": "current_account"
              }
            }
          }
        ],
        "scaffold": {
          "resource_routes": [
            "index",
            "show",
            "new",
            "create",
            "edit",
            "update",
            "destroy"
          ],
          "index": {
            "authorization": {
              "policy": "note.manage_own"
            },
            "projection": [
              {
                "field": "note.title"
              }
            ]
          },
          "show": {
            "authorization": {
              "policy": "note.manage_own"
            },
            "projection": [
              {
                "field": "note.title"
              }
            ]
          },
          "create": {
            "authorization": {
              "policy": "note.manage_own"
            },
            "inputs": [
              {
                "field": "note.title"
              }
            ],
            "bindings": [
              {
                "reference": "note.author",
                "value": {
                  "kind": "environment",
                  "name": "current_account"
                }
              }
            ]
          },
          "update": {
            "authorization": {
              "policy": "note.manage_own"
            },
            "inputs": [
              {
                "field": "note.title"
              }
            ]
          },
          "destroy": {
            "authorization": {
              "policy": "note.manage_own"
            }
          }
        }
      },
      {
        "subject_uuid": "01a1cb98-7455-7381-875e-185630b9f43b",
        "key": "language",
        "name": "Language",
