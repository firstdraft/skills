          "field": "language.name"
        },
        "fields": [
          {
            "subject_uuid": "01a1cb98-7455-7381-875e-18573fe981fb",
            "key": "name",
            "name": "Name",
            "type": "short_text",
            "required": true
          }
        ],
        "reference_data": {
          "identity": {
            "field": "language.name"
          },
          "records": [
            {
              "subject_uuid": "01a1cb98-7455-7381-875e-18585a25f721",
              "key": "english",
              "fields": [
                {
                  "field": "language.name",
                  "value": {
                    "kind": "literal",
                    "value": "English"
                  }
                }
              ]
            },
            {
              "subject_uuid": "01a1cb98-7455-7381-875e-18594fa96354",
              "key": "french",
              "fields": [
                {
                  "field": "language.name",
                  "value": {
                    "kind": "literal",
                    "value": "French"
                  }
                }
              ]
            }
          ]
        },
        "scaffold": {
          "resource_routes": [
            "index"
          ],
          "index": {
            "authorization": "public",
            "projection": [
              {
                "field": "language.name"
              }
            ]
          }
        }
      }
    ],
    "home_index": "note"
  }
}