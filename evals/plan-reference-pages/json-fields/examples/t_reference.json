  "application": {
    "key": "catalog",
    "name": "Catalog",
    "native": {},
    "delivery": {},
    "entities": [
      {
        "subject_uuid": "01a1cbae-9475-7000-8000-000000000901",
        "key": "product",
        "name": "Product",
        "primary_descriptor": {
          "field": "product.name"
        },
        "fields": [
          {
            "subject_uuid": "01a1cbae-9475-7000-8000-000000000902",
            "key": "name",
            "name": "Name",
            "type": "short_text",
            "required": true
          },
          {
            "subject_uuid": "01a1cbae-9475-7000-8000-000000000903",
            "key": "sku",
            "name": "SKU",
            "type": "short_text",
            "required": true
          },
          {
            "subject_uuid": "01a1cbae-9475-7000-8000-000000000904",
            "key": "specifications",
            "name": "Specifications",
            "type": "json",
            "required": true,
            "notes": "Attributes that differ by product, such as RAM for a laptop or fabric for a shirt.",
            "validations": [
              {
                "subject_uuid": "01a1cbae-9475-7000-8000-000000000908",
                "key": "has_weight",
                "owner": {
                  "description": "The specifications include a weight."
                }
              }
            ]
          },
          {
            "subject_uuid": "01a1cbae-9475-7000-8000-000000000905",
            "key": "supplier_record",
            "name": "Supplier record",
            "type": "json",
            "required": false,
            "immutable": true,
            "notes": "The record the supplier feed sent, pasted in when the product is added."
          }
        ],
        "predicates": [
          {
            "subject_uuid": "01a1cbae-9475-7000-8000-000000000909",
            "key": "red",
            "name": "Red",
            "owner": {
              "description": "Products whose specifications say the color is red."
            }
          }
        ],
        "scaffold": {
          "resource_routes": [
            "index",
            "show",
            "new",
            "create",
            "edit",
            "update",
            "destroy"
          ],
          "index": {
            "authorization": "public",
            "projection": [
              {
                "field": "product.name"
              },
              {
                "field": "product.sku"
              }
            ]
          },
          "show": {
            "authorization": "public",
            "projection": [
              {
                "field": "product.name"
              },
              {
                "field": "product.sku"
              },
              {
                "field": "product.specifications"
              },
              {
