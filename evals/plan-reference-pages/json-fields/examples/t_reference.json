              }
            ]
          },
          "create": {
            "authorization": "public",
            "inputs": [
              {
                "field": "product.name"
              },
              {
                "field": "product.sku"
              },
              {
                "field": "product.specifications"
              },
              {
                "field": "product.supplier_record"
              }
            ]
          },
          "update": {
            "authorization": "public",
            "inputs": [
              {
                "field": "product.name"
              },
              {
                "field": "product.sku"
              },
              {
                "field": "product.specifications"
              }
            ]
          },
          "destroy": {
            "authorization": "public"
          }
        }
      }
    ],
