                        "name": "current_account"
                      }
                    }
                  }
                ]
              },
              {
                "association": "project.members",
                "authorization": {
                  "policy": "user.signed_in",
                  "record": {
                    "kind": "environment",
                    "name": "current_account"
                  }
                }
              }
            ]
          }
        },
        "policies": [
          {
            "subject_uuid": "01a0caf3-075b-7000-8000-00000000f23a",
            "key": "read_member",
            "operation": "read",
            "allow_when": {
              "kind": "exists",
