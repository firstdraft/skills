                      "kind": "literal",
                      "value": "400"
                    }
                  }
                ],
                "when": {
                  "kind": "comparison",
                  "left": {
                    "target": {
                      "field": "rental.tier"
                    }
                  },
                  "operator": "equals",
                  "right": {
                    "kind": "literal",
                    "value": "standard"
                  }
                }
              }
            ]
          },
          {
            "subject_uuid": "01a0caf3-0990-7000-8000-0000000001d5",
