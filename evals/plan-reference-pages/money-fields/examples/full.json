                  "left": {
                    "target": {
                      "field": "rental.tier"
                    }
                  },
                  "operator": "equals",
                  "right": {
                    "kind": "literal",
                    "value": "premium"
                  }
                }
              },
              {
                "subject_uuid": "01a0caf3-0990-7000-8000-0000000001d7",
