            "required": true,
            "settings": {
              "currency": "USD"
            },
            "validations": [
              {
                "subject_uuid": "01a0caf3-0990-7000-8000-0000000001d2",
                "key": "positive",
                "kind": "comparison",
                "comparisons": [
                  {
                    "operator": "greater_than",
                    "right": {
                      "kind": "literal",
                      "value": "0"
                    }
                  }
                ]
              },
              {
                "subject_uuid": "01a0caf3-0990-7000-8000-0000000001d3",
                "key": "standard_cap",
                "kind": "comparison",
                "comparisons": [
                  {
                    "operator": "less_than_or_equal_to",
