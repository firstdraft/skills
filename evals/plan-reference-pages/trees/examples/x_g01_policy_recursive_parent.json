{
  "format": "firstdraft.foundation-plan.sketch/0.23",
  "target": {
    "id": "rails",
    "profile": "rails-sketch/2026-10"
  },
  "application": {
    "key": "tree_probe",
    "name": "Tree probe",
    "entities": [
      {
        "subject_uuid": "019fa300-2000-7000-8031-000000000008",
        "key": "user",
        "name": "User",
        "primary_descriptor": {
          "field": "user.name"
        },
        "fields": [
          {
            "subject_uuid": "019fa300-2000-7000-8031-000000000009",
            "key": "name",
            "name": "Name",
            "type": "short_text",
            "required": true
          }
        ],
        "account": {
          "identifiers": [
            {
              "kind": "email",
              "name": "Email"
            }
          ],
          "sign_in_methods": [
            {
              "kind": "password"
            }
          ],
          "registration": {
            "mode": "self_service",
            "inputs": [
              {
                "field": "user.name",
                "required": true
              }
            ]
          },
          "recovery": {
            "kind": "password_reset"
          },
          "lockout": {}
        }
      },
      {
        "subject_uuid": "019fa300-2000-7000-8031-000000000002",
        "key": "category",
        "name": "Category",
        "primary_descriptor": {
          "field": "category.name"
        },
        "fields": [
          {
            "subject_uuid": "019fa300-2000-7000-8031-000000000003",
            "key": "name",
            "name": "Name",
            "type": "short_text",
            "required": true
          }
        ],
        "references": [
          {
            "subject_uuid": "019fa300-2000-7000-8031-000000000001",
            "key": "parent",
            "name": "Parent",
            "targets": [
              "category"
            ],
            "required": false,
            "on_referenced_deleted": "restrict"
          },
          {
            "subject_uuid": "019fa300-2000-7000-8031-000000000006",
            "key": "owner",
            "name": "Owner",
            "targets": [
              "user"
            ],
            "required": true,
            "on_referenced_deleted": "delete_referencing_record"
          }
        ],
        "associations": [
          {
            "subject_uuid": "019fa300-2000-7000-8031-000000000004",
            "key": "children",
            "name": "Subcategories",
            "kind": "direct",
            "reference": "category.parent",
            "side": "referenced"
          }
        ],
        "trees": [
          {
            "subject_uuid": "019fa300-2000-7000-8031-000000000005",
            "key": "hierarchy",
            "parent_reference": "category.parent"
          }
        ],
        "scaffold": {
          "resource_routes": [
            "index",
            "show",
            "new",
            "create",
            "edit",
            "update",
            "destroy"
          ],
          "index": {
            "authorization": {
              "policy": "category.manage_tree"
            },
            "projection": [
              {
                "field": "category.name"
              },
              {
                "association": "category.parent",
                "authorization": {
                  "policy": "category.manage_tree"
                }
              }
            ]
          },
          "show": {
            "authorization": {
              "policy": "category.manage_tree"
            },
            "projection": [
              {
                "field": "category.name"
              },
              {
                "association": "category.parent",
                "authorization": {
                  "policy": "category.manage_tree"
                }
              },
              {
                "association": "category.children",
                "authorization": {
                  "policy": "category.manage_tree"
                },
                "projection": [
                  {
                    "field": "category.name"
                  }
                ],
                "create_form": {}
              }
            ]
          },
          "create": {
            "authorization": {
              "policy": "category.manage_tree"
            },
            "inputs": [
              {
                "field": "category.name"
              },
              {
                "association": "category.parent"
              }
            ],
            "bindings": [
              {
                "reference": "category.owner",
                "value": {
                  "kind": "environment",
                  "name": "current_account"
                }
              }
            ]
          },
          "update": {
            "authorization": {
              "policy": "category.manage_tree"
            },
            "inputs": [
              {
                "field": "category.name"
              },
              {
                "association": "category.parent"
              }
            ]
          },
          "destroy": {
            "authorization": {
              "policy": "category.manage_tree"
            }
          }
        },
        "policies": [
          {
            "subject_uuid": "019fa300-2000-7000-8031-000000000007",
            "key": "manage_tree",
            "operation": "manage",
            "allow_when": {
              "kind": "or",
              "expressions": [
                {
                  "kind": "comparison",
                  "left": {
                    "target": {
                      "association": "category.owner"
                    }
                  },
                  "operator": "equals",
                  "right": {
                    "kind": "environment",
                    "name": "current_account"
                  }
                },
                {
                  "kind": "matches_policy",
                  "association": "category.parent",
                  "policy": "category.manage_tree"
                }
              ]
            }
          }
        ]
      }
    ],
    "native": {},
    "delivery": {}
  }
}
